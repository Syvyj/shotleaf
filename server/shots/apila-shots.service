[Unit]
Description=APILA expiring screenshot links
After=network-online.target docker.service
Wants=network-online.target

[Service]
# The secret and the address live in /etc/apila-shots.env (see README.md).
EnvironmentFile=/etc/apila-shots.env
Environment=SHOTS_DIR=/var/lib/apila-shots
ExecStart=/usr/bin/python3 /opt/apila-shots/shots.py
DynamicUser=yes
StateDirectory=apila-shots
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
