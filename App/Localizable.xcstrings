{
  "sourceLanguage": "en",
  "strings": {
    "Set up the link server in Settings → Screenshot Links": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Налаштуйте сервер у Налаштуваннях → Посилання на скріншоти"
          }
        }
      }
    },
    "The server said no: %@": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер відмовив: %@"
          }
        }
      }
    },
    "The server didn't answer as expected": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер відповів не так, як треба"
          }
