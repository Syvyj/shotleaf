{
  "sourceLanguage": "en",
  "strings": {
    "Edit Last Screenshot": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Редагувати останній знімок"
          }
        }
      }
    },
    "Edit Image from Clipboard": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Редагувати картинку з буфера"
          }
        }
      }
    },
    "After a screenshot": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після знімка"
          }
        }
      }
    },
    "Open the editor": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрити редактор"
          }
        }
      }
    },
    "Copy and save": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Копіювати й зберегти"
          }
        }
      }
    },
    "Save to": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберігати в"
          }
        }
      }
    },
    "Desktop": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Робочий стіл"
          }
        }
      }
    },
    "Choose…": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибрати…"
          }
        }
      }
    },
    "File name": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ім'я файлу"
          }
        }
      }
    },
    "{date} and {time} are filled in: %@": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "{date} і {time} підставляються: %@"
          }
        }
      }
    },
    "Save at 1x": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберігати в розмірі 1x"
          }
        }
      }
    },
    "Retina shots are saved at half the pixels — smaller files.": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Знімки Retina зберігаються з удвічі меншою кількістю пікселів — файли менші."
          }
        }
      }
    },
    "Delay": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Затримка"
          }
        }
      }
    },
    "Include the pointer": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додавати вказівник миші"
          }
        }
      }
    },
    "Screenshots": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скріншоти"
          }
        }
      }
    },
    "Pen": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ручка"
          }
        }
      }
    },
    "Background": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фон"
          }
        }
      }
    },
    "Background, padding, corners · remove the background": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фон, поле, кути · прибрати фон"
          }
        }
      }
    },
    "Padding": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поле"
          }
        }
      }
    },
    "Corners": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кути"
          }
        }
      }
    },
    "Remove background": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прибрати фон"
          }
        }
      }
    },
    "Background removed · ⌘Z brings it back": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фон прибрано · ⌘Z поверне"
          }
        }
      }
    },
    "No subject found to keep": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не знайшов, що залишити"
          }
        }
      }
    },
    "Save as…": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберегти як…"
          }
        }
      }
    },
    "Share": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поширити"
          }
        }
      }
    },
    "%@ is taken (by another app or another APILA shortcut) — kept %@.": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ уже зайнято (іншою програмою або іншою дією APILA) — лишаю %@."
          }
        }
      }
    },
    "%@: %@": {
      "shouldTranslate": false
    },
    "%lld": {
      "shouldTranslate": false
    },
    "API key": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ API"
          }
        }
      }
    },
    "API keys are stored in the macOS Keychain. If the provider is unreachable, APILA falls back to Mock. Without image support, screenshots are sent as on-device OCR text.": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключі API зберігаються у Зв’язці ключів macOS. Якщо провайдер недоступний, APILA перемикається на Mock. Якщо модель не бачить зображень, скріншоти надсилаються як розпізнаний на Mac текст."
          }
        }
      }
    },
    "APILA": {
      "shouldTranslate": false
    },
    "APILA needs the %@ permission. Allow it in System Settings → Privacy & Security, then restart APILA.": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "APILA потрібен дозвіл «%@». Увімкніть його в Системних параметрах → Конфіденційність і безпека, потім перезапустіть APILA."
          }
        }
      }
    },
    "Aa": {
      "shouldTranslate": false
    },
    "Accessibility": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Універсальний доступ"
          }
        }
      }
    },
    "Accessibility is off — result copied to clipboard. Paste with ⌘V, or enable Accessibility in Settings to auto-paste.": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Універсальний доступ вимкнено — результат скопійовано. Вставте через ⌘V або увімкніть доступ у налаштуваннях, щоб APILA вставляла сама."
          }
        }
      }
    },
    "Accessibility is required for reading the selection and pasting the result; Screen Recording — for screenshots. After granting, fully restart APILA.": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Універсальний доступ потрібен, щоб читати виділення і вставляти результат; запис екрана — для скріншотів. Після дозволу повністю перезапустіть APILA."
          }
        }
      }
    },
    "Add ⌘, ⌥ or ⌃ (or use an F-key).": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте ⌘, ⌥ або ⌃ (або візьміть F-клавішу)."
          }
        }
      }
    },
    "After enabling APILA in the list, quit and reopen APILA.": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після того як увімкнете APILA у списку, закрийте й знову відкрийте APILA."
          }
        }
      }
    },
    "Allow Accessibility": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозвольте Універсальний доступ"
          }
        }
      }
    },
    "Apply crop": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обрізати"
          }
        }
